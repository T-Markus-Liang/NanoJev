  "phases": [
    {
      "id": "phase0_loopback_fake_upstream",
      "mode": "active",
      "upstream": "loopback_fake_only",
      "provider_calls_allowed": false,
      "requires_owner_authorization": false,
      "required_cases": [
        "active_eligible_drop",
        "provider_accounting_baseline",
        "anthropic_eligible_drop",
        "responses_eligible_drop",
        "unsupported_embeddings",
        "active_no_reduction",
        "shadow_control",
        "kill_switch",
        "scorer_error",
        "malformed_sidecar",
        "dependency_closure",
        "uncertain_score",
        "invalid_score_response",
        "scorer_timeout",
        "restore_manifest_too_large",
        "oversized_request_body",
        "internal_header_stripping"
      ],
      "purpose": "verify reduction applicator, restore header, receipts, supported wire formats, baseline accounting, unsupported-path bypass, no-reduction fallback, kill switch, dependency closure, scorer denial paths, request budgets, restore-header budget, and internal header stripping without provider calls"
    },
    {
      "id": "phase1_shadow_provider_measure",
      "mode": "shadow",
      "upstream": "provider_or_local_main_model",
      "provider_calls_allowed": false,
      "requires_owner_authorization": true,
      "purpose": "measure gate plan and provider-reported usage on original requests without sending reduced bytes"
    },
    {
      "id": "phase2_paired_canary",
      "mode": "active",
      "upstream": "provider_or_local_main_model",
      "provider_calls_allowed": false,
      "requires_owner_authorization": true,
      "purpose": "paired original/reduced provider accounting and downstream quality check; not authorized by this protocol"
    }
  ],
  "provider_accounting": {
    "actual_savings_requires_paired_provider_usage": true,
    "baseline_header": "x-nanojev-baseline-provider-prompt-tokens",
    "accepted_prompt_usage_fields": [
      "usage.prompt_tokens",
      "usage.input_tokens"
    ],
    "completion_usage_fields": [
      "usage.completion_tokens",
      "usage.output_tokens"
    ],
    "no_local_estimate_is_billing": true
  },
  "safety": {
    "fail_open_required": true,
    "kill_switch_env": "NANOJEV_GATEWAY_KILL_SWITCH",
    "restore_manifest_header_max_bytes": 4096,
    "scorer_timeout_seconds": 5.0,
    "upstream_timeout_seconds": 60.0,
    "max_requests_per_phase": 12,
    "max_body_bytes": 65536,
    "content_free_receipts_required": true,
    "raw_prompt_response_logging_forbidden": true,
    "protected_segment_veto_required": true,
    "dependency_closure_required": true,
    "round_trip_verification_required": true,
    "sidecar_header": "x-nanojev-sidecar"
  },
  "stop_conditions": [
    "any protected segment is proposed for removal",
    "any required evidence string is missing from reduced request",
    "any paired downstream answer regresses",
    "any restore-manifest reconstruction fails",
    "any scorer timeout, malformed output, or exception exceeds zero occurrences in phase0",
    "any request body exceeds max_body_bytes",
    "provider prompt-token usage is unavailable when actual savings is claimed",
    "receipt contains raw prompt, response, credential, or tool-output text",
    "owner revokes authorization or requests stop"
  ],
  "rollback": {
    "primary": "set NANOJEV_GATEWAY_KILL_SWITCH=1 and restart or keep running with deterministic kill switch",
    "fallback_mode": "shadow",
    "restore": "use X-NanoJev-Restore-Manifest on reduced responses; original bytes remain with caller",
    "expected_recovery_state": "all requests forwarded unchanged"
  },
  "scorers": {
    "strong_path": {
      "name": "Winnow-12B",
      "revision": "b6ac22b0d51b69b18200acacb3fbdd98073fffe8",
