      "adapter_sha256": "9797de69a42188e411b17b7b4fcb66a23374dcebc21d71a7a66f836b5d34df2b"
    }
  },
  "prohibited": [
    "active filtering before explicit owner operational authorization",
    "production threshold selection",
    "provider billing savings claim without paired provider-reported usage",
    "benchmark rows or scorer outputs used as training/calibration data",
    "raw prompt or generated response in public receipts",
    "remote scorer URLs",
    "redirect-following upstream calls"
  ]
}
